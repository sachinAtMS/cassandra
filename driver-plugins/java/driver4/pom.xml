<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.cassandra</groupId>
        <artifactId>cassandra-entra-id-auth-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>cassandra-entra-id-auth-driver4</artifactId>
    <packaging>jar</packaging>

    <name>Cassandra Entra ID Auth - Driver 4.x</name>
    <description>
        Microsoft Entra ID (Azure AD) authentication plugin for Apache Cassandra
        using the DataStax Java Driver 4.x. Provides an AuthProvider that acquires
        JWT tokens from Microsoft Entra ID via MSAL4J and authenticates to Cassandra's
        EntraIdAuthenticator using SASL PLAIN mechanism.
    </description>

    <properties>
        <datastax.driver4.version>4.17.0</datastax.driver4.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- DataStax Java Driver 4.x (provided - user supplies their driver version) -->
        <dependency>
            <groupId>com.datastax.oss</groupId>
            <artifactId>java-driver-core</artifactId>
            <version>${datastax.driver4.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Microsoft Authentication Library (MSAL4J) -->
        <dependency>
            <groupId>com.microsoft.azure</groupId>
            <artifactId>msal4j</artifactId>
        </dependency>

        <!-- SLF4J Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <relocations>
                                <relocation>
                                    <pattern>com.microsoft.aad.msal4j</pattern>
                                    <shadedPattern>org.apache.cassandra.shaded.msal4j</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.apache.cassandra.auth.entra.EntraIdAuthProviderV4</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
